{
  "artifacts": {
    "root_path": "artifacts/uit-dsc-2026-task2-v0400"
  },
  "competition": {
    "competition_id": "uit-dsc-2026-task2",
    "corpus_dataset_name": "uit-dsc-2026-task2-selected-contexts",
    "qa_dataset_name": "uit-dsc-2026-task2-legalqa",
    "data_policy": "competition_only",
    "allow_external_data": false,
    "require_official_artifact_lineage": true,
    "source_authority": "UIT Data Science Challenge 2026 Task 2 organizers"
  },
  "offline": {
    "chunking": {
      "max_tokens": 448,
      "max_search_tokens": 512,
      "min_tokens": 50,
      "overlap_tokens": 50,
      "tokenizer_name": "embedding_model_v1"
    }
  },
  "online": {
    "retrieval": {
      "top_k": 10,
      "candidate_k": 100,
      "default_strategy": "hybrid",
      "timeout_seconds": 120.0
    },
    "startup_validation": {
      "mode": "validated_report"
    },
    "vector_runtime": {
      "prefer_serving_metadata": true,
      "require_serving_metadata": true,
      "search_device": "cpu"
    },
    "query_understanding": {
      "enabled": true,
      "multi_query_enabled": true,
      "adaptive_routing_enabled": true,
      "max_variants": 3
    },
    "evidence_selection": {
      "enabled": true,
      "reference_match_boost": 2.0,
      "lexical_overlap_weight": 1.0,
      "inactive_penalty": 2.0
    },
    "claim_verification": {
      "enabled": true,
      "require_inline_citations": true,
      "minimum_lexical_support": 0.25,
      "minimum_claim_tokens": 2,
      "require_numeric_match": true,
      "require_negation_match": true,
      "max_claims": 20
    },
    "semantic_verification": {
      "backend": "disabled"
    },
    "generation": {
      "backend": "extractive"
    },
    "agent": {
      "max_retry": 2,
      "strategy_order": ["hybrid"],
      "rewrite_query_on_retry": false
    }
  },
  "build_validation": {
    "require_pinned_dataset_revision": true,
    "require_full_corpus": true,
    "expected_record_counts": {
      "contexts": 8532,
      "contexts_with_content": 8512
    },
    "report_filename": "build_validation_full_corpus.json"
  },
  "logging": {
    "level": "INFO"
  },
  "serving": {
    "host": "127.0.0.1",
    "port": 8000,
    "ui_enabled": true
  },
  "evaluation": {
    "cutoffs": [1, 5, 10],
    "strategy": "hybrid",
    "candidate_k": 100,
    "run_generation": true
  }
}
