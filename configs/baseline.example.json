{
  "artifacts": {
    "root_path": "artifacts"
  },
  "offline": {
    "dataset": {
      "dataset_name": "th1nhng0/vietnamese-legal-documents",
      "dataset_revision": null,
      "sample_limit": 100,
      "streaming": false
    },
    "relationship_normalization": {
      "relationship_type_mapping": {}
    }
  },
  "online": {
    "query_understanding": {
      "enabled": true,
      "multi_query_enabled": true,
      "adaptive_routing_enabled": true,
      "max_variants": 3
    },
    "evidence_selection": {
      "enabled": true,
      "reference_match_boost": 2.0,
      "lexical_overlap_weight": 1.0,
      "inactive_penalty": 2.0
    },
    "claim_verification": {
      "enabled": true,
      "require_inline_citations": true,
      "minimum_lexical_support": 0.25,
      "minimum_claim_tokens": 2,
      "require_numeric_match": true,
      "require_negation_match": true,
      "max_claims": 20
    },
    "semantic_verification": {
      "backend": "disabled"
    }
  },
  "logging": {
    "level": "INFO"
  },
  "serving": {
    "host": "127.0.0.1",
    "port": 8000,
    "ui_enabled": true
  },
  "evaluation": {
    "cutoffs": [1, 5, 10],
    "strategy": "hybrid_rerank",
    "candidate_k": 100,
    "run_generation": true
  }
}
