{
  "artifacts": {
    "root_path": "artifacts/aio-full-e5-small-v1"
  },
  "offline": {
    "dataset": {
      "dataset_name": "th1nhng0/vietnamese-legal-documents",
      "dataset_revision": "0a39ad7eae8e6c188cb225c4b1443c3b346461d8",
