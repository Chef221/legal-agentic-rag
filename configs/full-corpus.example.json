      "streaming": false
    },
    "embedding": {
      "device": "cuda"
    },
    "vector_index": {
      "embedding_batch_size": 64,
      "checkpoint_interval_batches": 100
    },
    "execution": {
      "resume_partial_build": true,
      "bounded_source_passes": true,
      "release_stage_memory": true,
      "document_processing_progress_interval": 1000
